
NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/wellmind?replicaSet=rs0
MONGO_DB_NAME=wellmind_dev

# JWT
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-32-caracteres-min

# Frontend / CORS
CORS_ORIGIN=http://localhost:3000

# Service IA Flask
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_TOKEN=remplacez-par-un-token-secret
AI_SERVICE_TIMEOUT_MS=60000

# Facultatif : réponse IA simulée, sans appeler le service Flask (développement uniquement)
# AI_SERVICE_MOCK=true

# Facultatif : mot de passe des comptes créés par npm run seed (refusé si NODE_ENV=production)
# SEED_PASSWORD=remplacez-par-un-mot-de-passe-de-test
