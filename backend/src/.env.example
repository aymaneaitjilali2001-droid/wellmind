NODE_ENV=development
PORT=4000

# MongoDB local (docker compose up -d) ou chaîne de connexion MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/wellmind?replicaSet=rs0

# Secret de signature des JWT (32 caractères minimum, à générer aléatoirement)
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-32-caracteres-min

# Origine autorisée du frontend (CORS)
CORS_ORIGIN=http://localhost:3000

# Service IA Flask et clé interne partagée avec lui
AI_SERVICE_URL=http://localhost:5001
AI_INTERNAL_KEY=remplacez-par-une-cle-interne-partagee
